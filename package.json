{
  "name": "next-dj",
  "version": "0.1.0",
  "description": "NextDJ desktop app",
  "desktopName": "nextdj",
  "license": "MIT",
  "author": {
    "name": "Antonio Leiva",
    "email": "antonio@devexperto.com"
  },
  "homepage": "https://github.com/antoniolg/next-dj",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/antoniolg/next-dj.git"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run dist:mac",
    "dist:all": "electron-vite build && electron-builder --mac --x64 --arm64 && electron-builder --win --x64 && electron-builder --linux --x64",
    "dist:linux": "electron-vite build && electron-builder --linux --x64",
    "dist:mac": "electron-vite build && electron-builder --mac --x64 --arm64",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "perf:snapshot": "node scripts/capture-renderer-perf.mjs",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@43.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
